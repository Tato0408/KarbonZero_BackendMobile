# Copia este archivo como .env y completa los valores.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# ── Base de datos (Oracle local, ver Database/KarbonZero.sql) ────
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USER=KARBONZERO
DB_PASSWORD=tu_contraseña
DB_DRIVER=oracle.jdbc.OracleDriver

# ── JWT ──────────────────────────────────────────────────────────
SECRET_KEY_JWT=una_clave_secreta_larga_y_dificil_de_adivinar_de_al_menos_32_caracteres
SECURITY_JWT_ISSUER=karbonZeroManagement
JWT_EXPIRATION=86400000

# ── Cookie de sesión ─────────────────────────────────────────────
# Vacío en local. En producción, el dominio público de esta API (ej. api.midominio.com).
COOKIE_DOMAIN=

# ── Correo saliente (Gmail con contraseña de aplicación) ─────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion

# ── Cloudinary (opcional, solo para subir imágenes) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
